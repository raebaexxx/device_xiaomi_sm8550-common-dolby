# Dolby Audio
vendor.audio.dolby.control.support=true

# AOSP Spatial audio is intentionally disabled.
# The framework spatializer engine that registers here is Xiaomi's
# mispatializer (libspatializer.so). It builds its renderer from
# /odm/etc/audio/misoundsa_spk_config.bin, which fuxi does not ship (it is
# absent from the stock ODM image as well). SpkCompensationConfigParser then
# fails, MisoundXTC is never constructed (ScapeRenderer+0x100 stays null), and
# ScapeRenderer::SetDeviceType() calls MisoundXTC::SetEnable() on that null
# pointer. That happens for every device type, not only for the speaker, so
# every spatializer attach kills the audio HAL. The stock fuxi audio policy
# declares no AUDIO_OUTPUT_FLAG_SPATIALIZER profile at all; we match that.
# Dolby surround/virtualization still comes from the DAP path (dax-default.xml).
ro.audio.spatializer_enabled=false

# Dolby Display / Vision
ro.vendor.display.dolbyvision.support=true
ro.vendor.mi_sf.gallery_p3_dolby_opt=true
debug.config.media.video.dolby_vision_suports=true